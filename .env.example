# Nuvora cloud configuration (OPTIONAL).
#
# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# Nothing here is needed to use the app: without it Nuvora runs fully on the
# device and the cloud and AI features stay hidden.
#
# Pass it to Flutter at build time (never commit real values):
#   flutter run   --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env

# Your Supabase project URL (Project Settings > API).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The project's *anon* (public) key. It is safe to ship in the app because
# row-level security limits what it can do. NEVER put the service-role key
# here or anywhere in the app.
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-side secrets are NOT set here. Set them on the server only:
#   supabase secrets set AI_PROVIDER_API_KEY=... AI_MODEL=... AI_DAILY_LIMIT=30
